{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "NIA · Tienda WooCommerce (demostración)",
    "description": "Tienda de demostración de NIA, taller de arte textil zapoteco.",
    "author": "NIA"
  },
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "woocommerce"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "setSiteLanguage",
      "language": "es_MX"
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "PEGAR-URL-DEL-TEMA/nia-telar.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; echo nia_demo_install();"
    }
  ]
}
