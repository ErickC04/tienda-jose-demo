{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "NIA · Tienda WooCommerce (demostración)",
    "description": "Tienda de demostración de NIA, taller de arte textil zapoteco.",
    "author": "NIA"
  },
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "woocommerce"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "setSiteLanguage",
      "language": "es_MX"
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/ErickC04/tienda-jose-demo",
        "ref": "main"
      },
      "options": {
        "activate": true,
        "targetFolderName": "nia-telar"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; echo nia_demo_install(); update_user_meta( 1, 'show_admin_bar_front', 'false' );"
    }
  ]
}
